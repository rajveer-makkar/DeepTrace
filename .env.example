# DeepTrace — Environment Variables
# Copy to .env and fill in your values.

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/deeptrace

# Redis (optional, for future task queue)
REDIS_URL=redis://redis:6379/0

# CORS — comma-separated origins allowed to access the API
CORS_ORIGINS=http://localhost:3000

# LLM API Keys (at least one required)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPPENCODE_API_KEY=

# Search API Keys (at least one required)
TAVILY_API_KEY=
BRAVE_API_KEY=
